# Copia in .env (non versionato). Per la FASE 0 non servono segreti:
# npm run check:osm funziona anche senza questo file, con gli stessi default.

# Endpoint Overpass, separati da virgola. Solo https: un indirizzo http:// viene rifiutato.
# Se il primo risponde 429 si attende Retry-After; su 502/504 si prova il successivo.
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Timeout di una singola richiesta, in secondi. Il default del codice, se la variabile manca, è 90.
OVERPASS_TIMEOUT=90

# User-Agent inviato a Overpass (politica d'uso di OpenStreetMap). Meglio un contatto reale.
OVERPASS_USER_AGENT=subiaco-isometrica/0.1 (verifica copertura OSM; https://github.com/NVerlini/subiaco-isometrica)

# Area usata da npm run check:osm quando non si passa un id. Vedi config/areas.json.
OSM_AREA=centro-storico

# Chromium di sistema per il render headless (FASE 2). playwright-core non scarica un browser.
# Vuoto: si cercano google-chrome e chromium. Esempio: /usr/bin/google-chrome
# Flag aggiunti dal render: SwiftShader, --ignore-gpu-blocklist, --no-sandbox
CHROME_PATH=
CHROME_ARGS=

# Cache locale delle tile in attesa di publish (FASE 5). Vuoto = data/web. Non versionare.
WEB_CACHE=

# Pittura (FASE 3). Lasciare vuoto: parte il provider mock, deterministico, senza rete.
# Per il provider reale (OpenAI Images, modello con modifica immagine):
#   PAINT_PROVIDER=openai
#   PAINT_API_KEY=sk-...        mai committare il valore, solo in .env
#   PAINT_MODEL=gpt-image-1
#   PAINT_API_BASE=https://api.openai.com/v1
# Lo stile e il prompt stanno in config/paint.json, non qui.
PAINT_PROVIDER=
PAINT_API_KEY=
PAINT_API_BASE=
PAINT_MODEL=

# Pubblicazione delle tile su Cloudflare R2 (FASE 5). Lasciare vuoto.
# npm run publish:tiles legge solo queste variabili, dal file .env. Non committare i valori.
# Senza questi campi il comando si ferma. Con --dry-run elenca i file e non contatta R2.
# Non copiare bucket o account id dai repository di riferimento.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pubblico del bucket (sottodominio r2.dev o dominio proprio), https, senza barra finale
# e senza utente o password. Il build di produzione lo incorpora nel viewer.
# npm run dev, in locale, ignora questo valore e legge le tile da data/.
TILES_PUBLIC_URL=

# Promemoria del sito, non usato dagli script. Il deploy lo fa Vercel dal repository.
SITE_URL=
